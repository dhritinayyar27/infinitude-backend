# ─── Infinitude Backend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit real secrets.
# Matching OS environment variables and JVM system properties override .env values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/infinitude

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT (auth cookie signing) ─────────────────────────────────────────────────
# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_real_secret_with_openssl_rand_base64_48
JWT_EXPIRATION_SECONDS=1800

# Server-owned Gemini credentials. Never put these in frontend variables.
# GEMINI_API_KEY also accepts a comma-separated key list. A nonempty normalized
# GEMINI_API_KEYS list overrides GEMINI_API_KEY; values are trimmed and deduplicated.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash

# ── OTP settings ──────────────────────────────────────────────────────────────
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ── Email (OTP delivery) ──────────────────────────────────────────────────────
# Required in development and production. OTPs are sent only by email, never logged.
# Set values for your SMTP provider; use an app password where required.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ── Gemini REST base URL (default is fine — only change if using a proxy) ─────
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
